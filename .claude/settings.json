{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/auto-push.sh\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
